# sent_id = LUKE_16.5
# text = Եւ կոչեցեալ առ ինքն մի ըստ միոջէ ի պարտականաց Տեառն իւրոյ. ասէ ցառաջինն՝ քանի՞ ինչ պարտիս տեառն իմում:
