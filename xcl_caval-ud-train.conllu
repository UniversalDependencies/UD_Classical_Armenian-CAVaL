# sent_id = MX.Hist_I_17.7
# text = Իսկ ի հասակ եւ ի միտս հասեալ որդւոց նորա՝ յիշեցուցանեն նմա զայս ամենայն, կարծելով ցածուցանել զնա ի դիւական պակշոտութենէն, եւ աւանդել զիշխանութիւնն եւ զգանձս՝ որդւոց իւրոց:
