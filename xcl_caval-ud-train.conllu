# sent_id = MX.Hist_I_5.2
# text = Եւ այս յայտնի է ամենեցուն, զի դժուարահաւաք եւ տաժանելի է որպէս գիւտ ժամանակացն ի սկզբանէ մինչեւ առ մեզ՝ առաւել եւս գիւտ նախարարականաց ազգաց ծննդոց յերից որդւոցն Նոյի, ցորքան կամք իցեն խուզել ումեք ըստ իւրաքանչիւր դարուց:
