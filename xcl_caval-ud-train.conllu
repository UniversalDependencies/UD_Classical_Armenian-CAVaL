# sent_id = MX.Hist_I_14.2
# text = Կարգեսցուք դոյզն յիշատակաւք բանից եւ որ ինչ զկնի այսորիկ յարեւմուտս սորա գործք քաջութեան պատմին ի նոյն մատենի, եւ որ ընդ Ասորեստանեայս կռիւն. զպատճառս եւ զզաւրութիւն իրացն միայն յայտնելով, եւ զերկարութիւն գործոյն համառաւտ բանիւ յանդիման կացուցանելով:
