# sent_id = MATT_21.16b
# text = Ասէ ցնոսա Յիսուս՝ այո չիցէ ընթերցեալ ձեր՝ թե ի բերանոյ տղայոց եւ ստնդիեցաց կատարեցեր զաւհրնութիւն:
